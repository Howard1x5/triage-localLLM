#!/bin/bash
# Block credential patterns and internal IPs
BLOCKED_PATTERNS=(
  "sk-ant-"
  "AKIA[A-Z0-9]{16}"
  "ghp_[A-Za-z0-9]{36}"
  "192\.168\.[0-9]+\.[0-9]+"
  "10\.[0-9]+\.[0-9]+\.[0-9]+"
  "172\.(1[6-9]|2[0-9]|3[01])\.[0-9]+\.[0-9]+"
)
FILES=$(git diff --cached --name-only)
for pattern in "${BLOCKED_PATTERNS[@]}"; do
  MATCHES=$(echo "$FILES" | xargs grep -l -E "$pattern" 2>/dev/null | grep -v ".githooks/")
  if [ -n "$MATCHES" ]; then
    echo "BLOCKED: pattern  found in: $MATCHES"
    exit 1
  fi
done
echo "Pre-commit checks passed."
exit 0
